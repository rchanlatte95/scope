    "cronstrue": "^3.14.0",
    "papaparse": "^5.5.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.9",
    "@playwright/test": "1.60.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.2.17",
